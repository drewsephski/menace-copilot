{
    "name": "menace-agent",
    "productName": "Menace Agent",
    "version": "1.0.0",
    "description": "Menace Agent — live interview autocue with OpenRouter and local Whisper",
    "main": "src/index.js",
    "scripts": {
        "start": "node scripts/ensure-macos-audio-helper.js && electron-forge start",
        "start:macos": "node scripts/ensure-macos-audio-helper.js && env -u ELECTRON_RUN_AS_NODE \"$HOME/Applications/Menace Agent Dev.app/Contents/MacOS/Electron\" .",
        "dev": "node scripts/ensure-macos-audio-helper.js && electron .",
        "macos:audio-permissions": "env -u ELECTRON_RUN_AS_NODE electron scripts/request-macos-audio-permission.js",
        "package": "electron-forge package",
        "package:macos": "node scripts/package-macos-manual.js",
        "package:macos:forge": "electron-forge package --platform=darwin",
        "make": "electron-forge make",
        "make:macos": "npm run package:macos && electron-forge make --platform=darwin --skip-package",
        "install:macos": "node scripts/install-macos-app.js",
        "publish": "electron-forge publish",
        "lint": "echo \"No linting configured\"",
        "polar:sync": "node scripts/sync-polar-production.js --write",
        "polar:test-discount": "node scripts/create-polar-test-discount.js",
        "test:license-flow": "node scripts/test-hosted-license-flow.js"
    },
    "keywords": [
        "menace agent",
        "interview assistant",
        "openrouter",
        "whisper",
        "live autocue"
    ],
    "author": {
        "name": "drew",
        "email": "drewsepeczi@gmail.com"
    },
    "dependencies": {
        "@google/genai": "^1.2.0",
        "electron-squirrel-startup": "^1.0.1",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.8.1",
        "@electron-forge/maker-deb": "^7.8.1",
        "@electron-forge/maker-dmg": "^7.8.1",
        "@electron-forge/maker-rpm": "^7.8.1",
        "@electron-forge/maker-squirrel": "^7.8.1",
        "@electron-forge/maker-zip": "^7.8.1",
        "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
        "@electron-forge/plugin-fuses": "^7.8.1",
        "@electron/fuses": "^1.8.0",
        "@reforged/maker-appimage": "^5.0.0",
        "electron": "^30.0.5"
    }
}
