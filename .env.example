# Local development only — never package provider or server secrets into the desktop app.

# BYOK development keys (main process / local eval only)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# GEMINI_API_KEY=your-gemini-key-here

# Public runtime config written into menace-runtime-config.json at packaging time
# MENACE_UPDATE_MANIFEST_URL=https://example.com/menace-agent/latest.json
# MENACE_RELEASE_PAGE_URL=https://example.com/menace-agent/releases
# MENACE_LOCAL_AI_BINARIES_BASE_URL=https://example.com/menace-agent/binaries
# MENACE_HOSTED_API_BASE_URL=https://api.example.com/menace

# Polar production — create at polar.sh → Settings → Developers
# Scopes needed for npm run polar:sync:
#   benefits:read, benefits:write
#   products:read, products:write
#   checkout_links:read, checkout_links:write
POLAR_ACCESS_TOKEN=polar_pat_your_token_here
POLAR_SERVER=production
POLAR_ORG_SLUG=menace

# Optional overrides after sync
# POLAR_ORGANIZATION_ID=
# POLAR_CHECKOUT_MONTHLY_URL=
# POLAR_CHECKOUT_SEARCH_PASS_URL=
# POLAR_CHECKOUT_BYOK_MONTHLY_URL=

# Dev only: skip Polar license checks when running unpackaged
# MENACE_SKIP_LICENSE=1

# Opt-in live eval only (never package)
# MENACE_EVAL_MODEL=google/gemini-2.5-flash
