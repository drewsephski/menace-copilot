# Server-side OpenRouter key for paid users (main process only — never commit the real key).
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional alias
# MENACE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Polar production — create at polar.sh → Settings → Developers
# Scopes needed for npm run polar:sync:
#   benefits:read, benefits:write
#   products:read, products:write
#   checkout_links:read, checkout_links:write
POLAR_ACCESS_TOKEN=polar_pat_your_token_here
POLAR_SERVER=production
POLAR_ORG_SLUG=menace

# Optional overrides after sync
# POLAR_ORGANIZATION_ID=
# POLAR_CHECKOUT_MONTHLY_URL=
# POLAR_CHECKOUT_SEARCH_PASS_URL=
# POLAR_CHECKOUT_BYOK_MONTHLY_URL=

# Dev only: skip Polar license checks when running unpackaged
# MENACE_SKIP_LICENSE=1
